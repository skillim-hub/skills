{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emergency-contact-first-aid:profile",
  "title": "EmergencyProfile",
  "type": "object",
  "required": [
    "profile_name",
    "last_reviewed",
    "site",
    "contacts"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "profile_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{2}[-/]\\d{2}[-/]\\d{4}$"
    },
    "site": {
      "type": "object",
      "required": [
        "address_line",
        "locality"
      ],
      "properties": {
        "address_line": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "locality": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "access_notes": {
          "type": "string",
          "maxLength": 500
        },
        "aed_location": {
          "type": "string",
          "maxLength": 250
        },
        "first_aid_kit_location": {
          "type": "string",
          "maxLength": 250
        }
      }
    },
    "emergency_services": {
      "type": "object"
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "priority"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "maxLength": 80
          },
          "relationship": {
            "type": "string",
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "can_receive_medical_info": {
            "type": "boolean"
          }
        }
      }
    },
    "medical_notes": {
      "type": "object"
    },
    "consent": {
      "type": "object"
    }
  }
}
