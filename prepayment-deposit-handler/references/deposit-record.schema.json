{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrepaymentDepositRecord",
  "type": "object",
  "required": [
    "deposit_id",
    "contract_id",
    "received_date",
    "amount",
    "payer",
    "payee",
    "nature"
  ],
  "properties": {
    "deposit_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "received_date": {
      "type": "string",
      "description": "YYYY-MM-DD or DD-MM-YYYY"
    },
    "amount": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "default": "ILS"
        }
      }
    },
    "payer": {
      "type": "object"
    },
    "payee": {
      "type": "object"
    },
    "nature": {
      "type": "string",
      "enum": [
        "advance_for_taxable_supply",
        "security_deposit_held_in_trust",
        "refundable_booking_deposit",
        "non_refundable_booking_fee",
        "retention_held_by_customer",
        "gift_card_or_credit_balance"
      ]
    }
  }
}
